# Environment variables for agent-logs-extractor
#
# Documentation only — nothing in this repo loads a .env file. There is no
# godotenv (or similar) dependency; cmd/agent-logs-extractor/main.go reads
# these directly via os.Getenv. Export them in your shell if you want them.

# Redirects every path — store, exports, and the default ~/.claude /
# ~/.codex lookups — under a custom root. Wins outright over XDG_DATA_HOME
# when set. Useful for tests and parallel runs.
AGENT_LOGS_EXTRACTOR_HOME=

# Log level (debug, info, warn, error); defaults to info. --log-level
# overrides this if passed.
AGENT_LOGS_EXTRACTOR_LOG_LEVEL=info

# Standard XDG base-directory variable, not agent-logs-extractor-specific.
# Governs the store/export data directory (not ~/.claude/~/.codex) when set
# to an absolute path and AGENT_LOGS_EXTRACTOR_HOME is unset.
XDG_DATA_HOME=
